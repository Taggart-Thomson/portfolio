---
// Shared frame for every project demo: a tour bar on top and the demo app below.
// The demo's own script renders into [data-demo-app] and calls mountTour() from ./tour.ts.
interface Props { id: string; label: string; notice?: string }
const DEFAULT_NOTICE = "This demo is for display purposes. The real tool works differently in the environment where it's deployed. All data here, including names and numbers, is fictional.";
const { id, label, notice = DEFAULT_NOTICE } = Astro.props;
---
<div class="demo-frame" id={id} data-demo-frame data-tour="intro">
  <div class="demo-chrome mono">
    <span class="dot"></span><span class="dot"></span><span class="dot"></span>
    <span class="demo-label">{label}</span>
    <span class="demo-flag">Fictional data</span>
  </div>
  <div class="demo-notice" role="note">
    <span class="demo-notice-icon" aria-hidden="true">!</span>
    <div>
      <strong class="demo-notice-title">Demo only. All names and numbers are fictional.</strong>
      <p>{notice}</p>
    </div>
  </div>
  <div class="tour-bar" data-tour-bar></div>
  <div class="demo-stage" data-demo-stage>
    <div class="demo-app" data-demo-app><slot /></div>
    <div class="tour-ring" data-tour-ring hidden></div>
  </div>
</div>

<style is:global>
  .demo-frame { position: relative; background: var(--paper); color: var(--ink); border: 3px solid var(--ink); border-radius: 22px; overflow: clip; }
  .demo-chrome { display: flex; align-items: center; gap: 6px; padding: 10px 14px; background: var(--ink); color: var(--paper); }
  .demo-chrome .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--yel); opacity: .9; }
  .demo-chrome .demo-label { margin-left: 8px; opacity: .85; }

  /* Very visible demo disclaimer: high contrast, first thing inside every demo. */
  .demo-notice { display: flex; gap: 14px; align-items: flex-start; padding: 18px 20px; background: #E8590C; color: #fff; border-bottom: 3px solid var(--ink); }
  .demo-notice-icon { flex: none; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #fff; color: #E8590C; font: 800 20px/1 var(--f-display); }
  .demo-notice-title { display: block; font-weight: 800; font-size: 20px; line-height: 1.2; letter-spacing: -.01em; }
  .demo-notice p { margin: 4px 0 0; font-size: 16px; line-height: 1.45; font-weight: 500; max-width: 75ch; }
  @media (max-width: 640px) { .demo-notice { padding: 14px; gap: 10px; } .demo-notice-title { font-size: 18px; } .demo-notice p { font-size: 15px; } }
  .demo-flag { margin-left: auto; font: 500 11px/1 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; background: #E8590C; color: #fff; border-radius: 999px; padding: 5px 9px; white-space: nowrap; }

  .tour-bar { position: sticky; top: 0; z-index: 30; background: var(--yel); border-bottom: 3px solid var(--ink); }
  .tb-row { display: flex; gap: 14px 20px; align-items: center; justify-content: space-between; flex-wrap: wrap; padding: 12px 16px; }
  .tb-text { flex: 1 1 320px; min-width: 0; }
  .tb-count { font: 500 11px/1.3 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; }
  .tb-title { font-weight: 800; font-size: 19px; line-height: 1.2; letter-spacing: -.01em; }
  .tb-body { font-size: 16px; line-height: 1.45; margin-top: 2px; max-width: 70ch; }
  .tb-hint { font: 500 12px/1.4 var(--f-mono); margin-top: 6px; }
  .tb-ctrl { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .tb-btn { font: 600 15px/1 var(--f-display); border: 0; border-radius: 999px; padding: 10px 16px; cursor: pointer; background: transparent; color: var(--ink); box-shadow: inset 0 0 0 2px var(--ink); }
  .tb-btn.solid { background: var(--ink); color: var(--yel); }
  .tb-btn.link { box-shadow: none; text-decoration: underline; text-underline-offset: 3px; padding-inline: 6px; }
  .tb-btn:disabled { opacity: .35; cursor: default; }
  .tb-progress { height: 4px; background: rgba(18,18,18,.15); }
  .tb-progress span { display: block; height: 100%; background: var(--ink); transition: width .25s ease; }
  @media (max-width: 640px) {
    .tb-row { padding: 10px 12px; }
    .tb-title { font-size: 17px; }
    .tb-body { font-size: 15px; }
    .tb-ctrl { width: 100%; }
    .tb-btn { padding: 9px 14px; font-size: 14px; }
  }

  .demo-stage { position: relative; overflow: clip; }
  .tour-ring { position: absolute; z-index: 20; border-radius: 12px; pointer-events: none; outline: 3px solid var(--yel); box-shadow: 0 0 0 3px var(--ink), 0 0 0 9999px rgba(18,18,18,.42); transition: left .2s ease, top .2s ease, width .2s ease, height .2s ease; }
  .tour-ring::after { content: ""; position: absolute; inset: -3px; border-radius: 14px; border: 3px solid var(--yel); animation: tour-pulse 1.6s ease-out infinite; }
  @keyframes tour-pulse { from { opacity: .9; transform: scale(1); } to { opacity: 0; transform: scale(1.06); } }
</style>

---
import DemoFrame from "../../components/tour/DemoFrame.astro";
---
<DemoFrame id="demo-lastro" label="Lastro demo · sample data · not financial advice" notice="This demo is for display purposes. The real tool works differently in the environment where it's deployed. All data here, including holdings, prices, names and numbers, is fictional. Ticker symbols appear only as examples. Not financial advice.">
  <noscript><p style="padding:20px">This demo needs JavaScript.</p></noscript>
</DemoFrame>

<script>
  import "./app";
</script>

<style is:global>
  /* Lastro's own brand inside the frame: dark ink, bone text, brass kept scarce, green and red for data. */
  .lt-app {
    --l-ink: #0b0c0e; --l-brass: #c9a227; --l-bone: #f4f1e8; --l-muted: #8a8f98; --l-gain: #1d9e75; --l-loss: #e24b4a;
    --l-surface: #131417; --l-raised: #191b1f; --l-line: #24262b; --l-line2: #33363d;
    --l-ui: -apple-system, BlinkMacSystemFont, "SF Pro Text", system-ui, sans-serif;
    --l-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
    background: var(--l-ink); color: var(--l-bone); font: 400 14px/1.45 var(--l-ui); padding: 0 0 16px;
  }
  .lt-app .m { font-family: var(--l-mono); font-size: 13px; }
  .lt-app .gain { color: var(--l-gain); }
  .lt-app .loss { color: var(--l-loss); }
  .lt-sub { color: var(--l-muted); font-size: 12px; }
  .lt-banner { background: var(--l-bone); color: var(--l-ink); text-align: center; font-weight: 500; padding: 8px 12px; font-size: 14px; }
  .lt-top { display: flex; align-items: center; gap: 12px 16px; flex-wrap: wrap; padding: 12px 16px; border-bottom: 1px solid var(--l-line); }
  .lt-logo { height: 40px; width: auto; }
  .lt-tabs { display: flex; gap: 4px; flex: 1; }
  .lt-tabs button { font: 500 14px/1 var(--l-ui); background: transparent; color: var(--l-muted); border: 0; border-bottom: 2px solid transparent; padding: 10px 10px 8px; cursor: pointer; }
  .lt-tabs button[aria-pressed="true"] { color: var(--l-bone); border-bottom-color: var(--l-brass); }
  .lt-menuwrap { position: relative; }
  .lt-btn { font: 500 14px/1 var(--l-ui); background: var(--l-raised); color: var(--l-bone); border: 1px solid var(--l-line2); border-radius: 6px; padding: 9px 12px; cursor: pointer; }
  .lt-menu { position: absolute; right: 0; top: calc(100% + 6px); z-index: 5; background: var(--l-raised); border: 1px solid var(--l-line2); border-radius: 6px; padding: 4px; display: grid; min-width: 180px; box-shadow: 0 10px 30px rgba(0,0,0,.5); }
  .lt-menu button { text-align: left; font: 400 14px/1.2 var(--l-ui); background: transparent; color: var(--l-bone); border: 0; padding: 9px 10px; border-radius: 4px; cursor: pointer; }
  .lt-menu button:hover { background: var(--l-line); }

  .lt-grid { display: grid; gap: 12px; padding: 12px 16px 0; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-flow: dense; }
  @media (max-width: 900px) { .lt-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .lt-grid { grid-template-columns: minmax(0, 1fr); padding: 10px 10px 0; } .lt-panel.wide { grid-column: auto !important; } .lt-top { padding: 10px; } }
  .lt-panel { background: var(--l-surface); border: 1px solid var(--l-line); border-radius: 6px; min-width: 0; display: flex; flex-direction: column; }
  .lt-panel.wide { grid-column: span 2; }
  .lt-ph { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 8px 10px; border-bottom: 1px solid var(--l-line); }
  .lt-ph h4 { margin: 0; font: 500 13px/1 var(--l-ui); letter-spacing: .02em; }
  .lt-pc { display: flex; gap: 2px; }
  .lt-pc button { background: transparent; color: var(--l-muted); border: 1px solid transparent; border-radius: 4px; width: 26px; height: 24px; cursor: pointer; font-size: 13px; line-height: 1; }
  .lt-pc button:hover:not(:disabled) { border-color: var(--l-line2); color: var(--l-bone); }
  .lt-pc button:disabled { opacity: .3; cursor: default; }
  .lt-pb { padding: 10px; overflow-x: auto; }
  .lt-foot { margin-top: 8px; }

  .lt-t { width: 100%; border-collapse: collapse; font-size: 13px; }
  .lt-t th { text-align: left; font: 500 11px/1.2 var(--l-ui); color: var(--l-muted); padding: 6px; border-bottom: 1px solid var(--l-line); white-space: nowrap; }
  .lt-t td { padding: 7px 6px; border-bottom: 1px solid var(--l-line); vertical-align: top; white-space: nowrap; }
  .lt-t tr.fail td { background: rgba(226,75,74,.07); }
  .lt-t td .lt-sub, .lt-t td.lt-sub { white-space: normal; min-width: 180px; }
  .lt-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .lt-list li { display: flex; justify-content: space-between; gap: 10px; padding: 6px 0; border-bottom: 1px solid var(--l-line); }

  .lt-sugs { display: grid; gap: 8px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); }
  .lt-sug { background: var(--l-raised); border: 1px solid var(--l-line); border-radius: 6px; padding: 10px; }
  .lt-sug p { margin: 6px 0; }
  .lt-sug-h { display: flex; gap: 8px; align-items: center; }
  .lt-act { font: 500 11px/1 var(--l-mono); text-transform: uppercase; padding: 4px 6px; border-radius: 4px; border: 1px solid currentColor; }
  .a-buy { color: var(--l-gain); }
  .a-trim { color: var(--l-loss); }
  .a-hold { color: var(--l-muted); }
  .lt-rej { margin-top: 10px; padding: 8px 10px; border: 1px dashed var(--l-loss); border-radius: 6px; font-size: 13px; }
  .lt-news { margin: 0; padding-left: 1.1em; display: grid; gap: 6px; }

  .lt-chat { display: grid; gap: 8px; margin-bottom: 10px; }
  .lt-msg { padding: 8px 10px; border-radius: 6px; max-width: 60ch; }
  .lt-msg.you { justify-self: end; background: var(--l-bone); color: var(--l-ink); }
  .lt-msg.advisor { background: var(--l-raised); border: 1px solid var(--l-line); }
  .lt-prompts { display: flex; gap: 6px; flex-wrap: wrap; }
  .lt-chip { font: 400 13px/1.25 var(--l-ui); background: transparent; color: var(--l-bone); border: 1px solid var(--l-line2); border-radius: 999px; padding: 6px 10px; cursor: pointer; text-align: left; }
  .lt-chip:hover { border-color: var(--l-bone); }
  .lt-mem { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .lt-mem li { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 8px; align-items: start; padding: 8px; background: var(--l-raised); border-radius: 6px; }
  .lt-kind { font: 500 10px/1 var(--l-mono); text-transform: uppercase; padding: 4px 5px; border: 1px solid var(--l-line2); border-radius: 4px; color: var(--l-muted); }
  .k-budget .lt-kind { color: var(--l-bone); border-color: var(--l-bone); }
  .lt-said { color: var(--l-muted); font-size: 12px; margin-top: 3px; font-style: italic; }
  .lt-big { font-size: 26px !important; margin: 4px 0; }
  .lt-report .lt-list { margin-top: 8px; }
</style>

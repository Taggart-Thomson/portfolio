---
import Base from "../layouts/Base.astro";
import RevealEmail from "../components/RevealEmail.astro";

const roles = [
  {
    when: "October 2023 to now",
    title: "Online Program Director",
    org: "Think Tank Training Centre, a global online VFX and 3D art school",
    points: [
      "I run the online program: about 500 students a term (600 at peak), 22 to 36 supervisors and 72 mentors, across every time zone.",
      "I own a contractor budget of about CAD 490,000 per term and am relied on for cost-saving measures.",
      "I modeled a new supervisor group structure, got it approved by leadership and implemented it. It saves about CAD 119,677 per term, or about CAD 360,000 a year.",
      "I run each term build end to end. For the October 2026 term, I launched 24 supervisor groups on the promised date, with all 22 supervisors confirmed within 48 hours, and placed just over 220 students into them with my Term Scheduler.",
      "I work daily with academics and compliance, accounting, marketing and engineering, and report to the founder.",
    ],
  },
  {
    when: "February 2017 to October 2023",
    title: "Co-Founder",
    org: "Try Creative Media Group, Shanghai",
    points: [
      "We started with 2 founders and no clients and grew to 9 people and more than CNY 4 million a year in revenue.",
      "Clients included BMW, Cartier, Porsche, McLaren, Jaguar Land Rover, Heineken, Dom Pérignon, Rémy Martin, Yves Saint Laurent, L'Oréal, Michelin and Marriott Bonvoy: TV commercials, social ads, launch screens, event recaps and 3D work, up to flagship events like the W Hotel opening and Porsche's 20-year anniversary in China.",
      "I owned business development, pricing, budgets, vendors, invoicing and delivery, and presented strategy directly to senior client stakeholders.",
      "During COVID, I restructured the business to keep clients supplied.",
    ],
  },
  {
    when: "October 2015 to February 2017",
    title: "Senior Associate, Head of Digital Content",
    org: "Red Gate International, Shanghai",
    points: [
      "I led client coordination on international PR events and brand campaigns and produced their digital content.",
      "I reviewed contracts, reports and proposals for accuracy and compliance.",
    ],
  },
];

const looking = [
  "Forward-deployed engineering and AI deployment",
  "AI solutions and solutions engineering",
  "AI enablement and AI operations",
  "AI workflow and business process automation",
  "AI agents and internal tools",
  "GTM engineering and revenue systems",
  "AI product and technical product roles",
  "AI implementation and program leadership",
  "AI transformation consulting",
  "Business systems and operations leadership",
];

const skills = [
  ["AI", "Claude and Claude Code (daily), the Anthropic API, RAG, embeddings and semantic search, tool-using agents with human approval steps, MCP, Claude Skills, prompt and context design, prompt caching, LLM-based extraction, guardrails and rate limiting, AI cost tracking."],
  ["Building", "Python, TypeScript, JavaScript, FastAPI, Flask, Django, React, Astro, SQL, PostgreSQL, SQLite, REST APIs, Git, GitHub Actions, pytest, Cloudflare Workers, offline-first web apps."],
  ["Data", "Data cleaning and pipelines, messy real-world data and name matching, job board APIs (Greenhouse, Lever), Excel cost and scenario modeling, KPI design and reporting dashboards, PDF and Excel exports."],
  ["Automation", "Google Apps Script, Google Forms and Sheets, HubSpot workflows, HTML email, Zoom integration, scheduled jobs, Google Workspace, ClickUp, Miro, Figma."],
  ["Delivery", "Workflow discovery, scoping and requirements, rapid prototyping, user testing and redesign, rollout and adoption, working with engineering teams to ship to production, privacy by design."],
  ["Operating", "Budget ownership (about CAD 490,000 a term), cost-saving business cases, revenue growth as a co-founder, pricing and proposals, business development, global brand clients, contractor contracts and onboarding, reporting to leadership, cross-functional delivery."],
];
---
<Base title="About" description="Operations leader who builds AI and automation tools. Based remotely, relocating to Canada.">
  <section class="head">
    <div class="wrap">
      <h1>About</h1>
      <p class="lede">
        I'm an operator who can also build. I've spent eleven years running operations and businesses,
        including years in digital media, and I now build AI and automation tools that teams actually use.
      </p>
    </div>
  </section>

  <section class="wrap cols" id="how-i-work">
    <div>
      <h2 class="mono">How I work</h2>
      <p>
        I start where the work actually happens. I find where time or money is being lost, build the first
        working version myself with AI tools, put it in front of the people who will use it, measure the
        result and fix what breaks.
      </p>
      <p>
        I'm most useful between the business and the engineering team. I've owned budgets, run a program of
        about 500 students a term and built a company, so I know what a tool has to deliver. Then I build it.
        When it needs to scale, I work with engineers to take it into production, as I did with the Virtual
        Program Assistant and the Term Scheduler.
      </p>
      <p>
        I learn project first. Every tool on this site started as a real problem I needed solved.
      </p>
    </div>
    <div>
      <h2 class="mono">What I'm looking for</h2>
      <ul>
        {looking.map((r) => <li>{r}</li>)}
      </ul>
      <h2 class="mono">Where I'm based</h2>
      <p>
        Canadian citizen, born and raised in Calgary. I'm working remotely from Brazil and relocating to Canada.
        Open to remote roles in Canada and the Americas and hybrid roles in Canada. No sponsorship needed in Canada.
      </p>
      <p>English is my native language. My Portuguese is intermediate and improving.</p>
    </div>
  </section>

  <section class="wrap block" id="experience">
    <h2 class="big">Experience</h2>
    {roles.map((r) => (
      <div class="role">
        <div class="mono when">{r.when}</div>
        <div>
          <h3>{r.title}</h3>
          <div class="org">{r.org}</div>
          <ul>{r.points.map((pt) => <li>{pt}</li>)}</ul>
        </div>
      </div>
    ))}
  </section>

  <section class="wrap block" id="other-work">
    <h2 class="big">Other work</h2>
    <div class="role">
      <div class="mono when">Every term</div>
      <div>
        <h3>HubSpot workflow automation</h3>
        <p>
          I own the school's student messaging in HubSpot (Marketing Hub Professional). Every term I build and
          launch 9 automated workflows that carry students through onboarding, orientations, reminders and
          webinars, all timed to that term's dates.
        </p>
        <ul>
          <li>I rebuild every workflow each term: new send dates, links and enrollment lists, then I test and launch them. Once live, enrollment and sends run on their own.</li>
          <li>I build the emails in HTML and set up the triggered sends.</li>
          <li>A Zoom webinar integration enrolls every member automatically, so nobody has to be added by hand.</li>
          <li>I also manage the static lists and the support ticket queue, which I work through with the team twice a week.</li>
          <li>Next, I've scoped a phase that automates the term rebuild itself, with timing relative to each student's enrollment and lists created through the API.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap block" id="education">
    <h2 class="big">Education</h2>
    <div class="edu">
      <p class="lead">
        I started in business, then went to film school, built a career on both, and have now turned it all
        toward AI.
      </p>
      <p>
        I earned a <strong>Bachelor of Commerce in Accounting and Finance</strong> in 2010, then studied
        <strong>Visual Art and Design</strong> in 2011. That combination took me into digital media and, in 2017,
        to co-founding a production company in Shanghai. In 2024 I completed an <strong>MBA in Management</strong>
        at the University of East London. It sharpened how I think about cost, people and results, which is how
        I judge every tool I build.
      </p>
      <p>
        Now I'm doing an <strong>MS in AI Engineering</strong> at Quantic School of Business and Technology
        (2026 to 2027). Since May 2026 I've completed 24 courses, each with a proof of completion. They cover
        building AI systems end to end: AI agents, LLM-based apps and prompt engineering; AI-assisted and
        agentic software development, software testing, CI/CD and performance monitoring; cloud foundations,
        relational databases and back ends; and the leadership side, from managing AI application development
        to adopting AI across an organization.
      </p>
    </div>
  </section>

  <section class="wrap block last" id="skills">
    <h2 class="big">Skills</h2>
    <div class="table">
      {skills.map(([k, v]) => (
        <div class="srow"><span class="mono">{k}</span><span>{v}</span></div>
      ))}
    </div>
    <div class="cta">
      <RevealEmail label="Email me" />
      <a class="btn ghost" href="/#work">See the work</a>
    </div>
  </section>
</Base>

<style>
  .head { background: var(--yel); padding-block: 8px clamp(36px, 6vw, 64px); }
  h1 { font-weight: 800; font-size: clamp(64px, 13vw, 180px); line-height: .84; letter-spacing: -.045em; margin: 20px 0 0; }
  .lede { font-size: clamp(20px, 2.3vw, 28px); line-height: 1.35; max-width: 40ch; margin: 24px 0 0; }

  .cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(24px, 5vw, 64px); padding-block: clamp(40px, 6vw, 72px); }
  @media (max-width: 820px) { .cols { grid-template-columns: minmax(0, 1fr); } }
  .cols h2 { margin: 0 0 10px; font-weight: 500; }
  .cols h2:not(:first-child) { margin-top: 28px; }
  .cols p, .cols li { font-size: 19px; line-height: 1.6; }
  .cols p { margin: 0 0 14px; }
  .cols ul { margin: 0; padding-left: 1.2em; }

  .block { border-top: 3px solid var(--ink); padding-block: clamp(32px, 5vw, 56px); }
  .big { font-weight: 800; font-size: clamp(36px, 6vw, 72px); letter-spacing: -.04em; line-height: .95; margin: 0 0 24px; }
  .role { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 24px; padding-block: 18px; }
  .role + .role { border-top: 1.5px solid var(--ink); }
  @media (max-width: 760px) { .role { grid-template-columns: minmax(0, 1fr); gap: 6px; } }
  .when { padding-top: 8px; }
  h3 { font-weight: 800; font-size: clamp(22px, 2.6vw, 30px); letter-spacing: -.02em; margin: 0; line-height: 1.1; }
  .org { color: var(--muted); margin-top: 4px; }
  .role ul { padding-left: 1.2em; margin: 12px 0 0; }
  .role li, .role p { font-size: 18px; line-height: 1.55; margin: 6px 0; }

  .table > div { display: grid; gap: 16px; padding-block: 14px; border-bottom: 1.5px solid var(--ink); align-items: baseline; }
  .srow { grid-template-columns: 160px minmax(0, 1fr); }
  @media (max-width: 760px) { .srow { grid-template-columns: minmax(0, 1fr) !important; gap: 4px !important; } }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .edu { max-width: 68ch; }
  .edu p { font-size: 19px; line-height: 1.6; margin: 0 0 16px; }
  .edu .lead { font-size: clamp(22px, 2.6vw, 30px); line-height: 1.3; font-weight: 700; letter-spacing: -.01em; }
  .last { padding-bottom: clamp(48px, 7vw, 88px); }
</style>

---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { demoLabel } from "../../lib/labels";

// Each project's demo lives in src/demos/<slug>/Demo.astro. Pages without one show the placeholder.
const demos = import.meta.glob<{ default: any }>("../../demos/*/Demo.astro", { eager: true });

export async function getStaticPaths() {
  const all = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
  return all.map((p, i) => ({ params: { slug: p.id }, props: { p, next: all[(i + 1) % all.length] } }));
}
const { p, next } = Astro.props;
const { Content } = await render(p);
const d = p.data;
const Demo = demos[`../../demos/${p.id}/Demo.astro`]?.default;
---
<Base title={d.title} description={d.summary}>
  <section class="head">
    <div class="wrap">
      <div class="mono crumbs"><a href="/#work">Work</a> / {d.kicker}</div>
      <h1>{d.title}</h1>
      <p class="sum">{d.summary}</p>
      <dl class="facts">
        <div><dt class="mono">Where</dt><dd>{d.where}</dd></div>
        <div><dt class="mono">Status</dt><dd>{d.status}</dd></div>
        <div><dt class="mono">Stack</dt><dd>{d.stack.join(", ")}</dd></div>
      </dl>
    </div>
  </section>

  <section class="wrap demo-slot" aria-label={demoLabel[d.demo]}>
    {Demo ? (
      <>
      <div class="demo-intro">
        <span class="tag solid">{demoLabel[d.demo]}</span>
        <p>{d.demoNote}</p>
      </div>
      <Demo />
      </>
    ) : (
      <div class="demo">
        <span class="tag solid">{demoLabel[d.demo]}</span>
        <p>{d.demoNote}</p>
        <p class="mono soon">In progress</p>
      </div>
    )}
  </section>

  <article class="wrap prose">
    <Content />
  </article>

  <nav class="wrap nextp" aria-label="Next project">
    <a href={`/projects/${next.id}`}>
      <span class="mono">Next project</span>
      <span class="t">{next.data.title} &#8594;</span>
    </a>
  </nav>
</Base>

<style>
  .head { background: var(--yel); padding-block: 8px clamp(36px, 6vw, 64px); }
  .crumbs a { text-decoration: none; }
  h1 { font-weight: 800; font-size: clamp(52px, 10vw, 136px); line-height: .86; letter-spacing: -.045em; margin: 20px 0 0; }
  .sum { font-size: clamp(19px, 2vw, 24px); max-width: 44ch; margin: 22px 0 0; }
  .facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin: 32px 0 0; border-top: 3px solid var(--ink); padding-top: 16px; }
  @media (max-width: 760px) { .facts { grid-template-columns: minmax(0, 1fr); } }
  .facts dd { margin: 6px 0 0; font-size: 17px; }

  .demo-slot { margin-top: clamp(28px, 5vw, 48px); }
  .demo { background: var(--ink); color: var(--paper); border-radius: 22px; padding: clamp(20px, 4vw, 36px); min-height: 220px; display: flex; flex-direction: column; gap: 12px; justify-content: center; }
  .demo .tag.solid { background: var(--yel); color: var(--ink); border-color: var(--yel); align-self: flex-start; }
  .demo p { margin: 0; max-width: 62ch; font-size: 18px; }
  .soon { color: var(--yel); }
  .demo-intro { display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px; }
  .demo-intro .tag { align-self: flex-start; }
  .demo-intro p { margin: 0; max-width: 70ch; font-size: 18px; }

  .prose { max-width: 760px; padding-block: clamp(36px, 6vw, 72px); }
  .prose :global(h2) { font-weight: 800; font-size: clamp(26px, 3vw, 34px); letter-spacing: -.02em; line-height: 1.1; margin: 1.8em 0 .5em; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(p), .prose :global(li) { font-size: 19px; line-height: 1.6; }
  .prose :global(code) { font-family: var(--f-mono); font-size: .85em; background: #F3E9A6; padding: 1px 5px; border-radius: 4px; }
  .prose :global(ul) { padding-left: 1.2em; }

  .nextp { padding-bottom: clamp(40px, 6vw, 80px); }
  .nextp a { display: block; border-top: 3px solid var(--ink); padding-top: 18px; text-decoration: none; }
  .nextp .t { display: block; font-weight: 800; font-size: clamp(30px, 5vw, 60px); letter-spacing: -.035em; line-height: 1; margin-top: 8px; }
  .nextp a:hover .t { text-decoration: underline; text-decoration-thickness: 4px; text-underline-offset: 6px; }
</style>

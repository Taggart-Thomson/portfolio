// Cloudflare Workers config. For now the Worker only serves the built static site from ./dist.
// The chat endpoint (/api/chat) gets added here later.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  }
}
